FROM ros:lyrical-ros-base-resolute

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git patchelf binutils dotnet-sdk-10.0 \
    python3-vcstool python3-colcon-common-extensions python3-pytest \
    ros-lyrical-test-msgs ros-lyrical-rmw-fastrtps-cpp \
    ros-lyrical-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
WORKDIR /work/ros2-for-unity
# The ROS base image entrypoint sources /opt/ros/lyrical/setup.bash.
CMD ["bash"]
