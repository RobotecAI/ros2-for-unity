<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(HarnessEditor)' == 'true'">UNITY_EDITOR</DefineConstants>
    <DefineConstants>$(DefineConstants);ENABLE_MONO</DefineConstants>
    <DefineConstants Condition="'$(HarnessCustom)' == 'true'">$(DefineConstants);CUSTOM_INTERFACES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Ros2ForUnity/Scripts/**/*.cs" />
    <Compile Include="*.cs" />
    <Reference Include="$(RosAssemblies)/*.dll" />
  </ItemGroup>
</Project>
